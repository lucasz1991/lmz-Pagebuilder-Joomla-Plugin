<?xml version="1.0" encoding="utf-8"?>
<!--
    Versionsverzeichnis der LMZ Builder Suite.

    Diese Datei wird vom Bau-Skript erzeugt und ueberschrieben. Von Hand
    aendern lohnt nicht: beim naechsten Bau ist es weg.

    NOCH LEER, UND ZWAR ABSICHTLICH. Ein Eintrag, der auf ein Paket zeigt,
    das noch nicht ausgeliefert ist, wuerde auf jeder angeschlossenen Seite
    eine Aktualisierung melden, die beim Laden scheitert. Ein leeres
    Verzeichnis bedeutet fuer Joomla schlicht "nichts Neues" - das ist der
    ehrliche Zustand, solange das Produktpaket nicht fertig ist.

    Sobald es das ist, sieht ein Eintrag so aus:

    <update>
        <name>LMZ Builder Suite</name>
        <description>Seitenbaukasten, Kartenmodul und Steuerschnittstelle.</description>
        <element>pkg_lmzbuilder</element>
        <type>package</type>
        <client>site</client>
        <version>1.1.0</version>
        <downloads>
            <downloadurl type="full" format="zip">https://src.follow-flow.de/lmzbuilder/get.php?f=pkg_lmzbuilder-1.1.0.zip</downloadurl>
        </downloads>
        <tags><tag>stable</tag></tags>
        <maintainer>LMZ Media</maintainer>
        <maintainerurl>https://lmz-media.de</maintainerurl>
        <targetplatform name="joomla" version="5\.[0-9]+" />
        <php_minimum>8.1.0</php_minimum>
        <sha256>...</sha256>
    </update>

    Zur Downloadadresse: sie zeigt auf get.php, nicht direkt auf das Archiv.
    Joomla haengt den in "Extra Query" hinterlegten Schluessel automatisch an -
    aus ...?f=paket.zip wird ...?f=paket.zip&key=<schluessel>. Der Ordner
    packages/ ist per .htaccess gesperrt, das Archiv also nur ueber den
    Torwaechter erreichbar.
-->
<updates>
</updates>
